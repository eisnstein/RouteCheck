<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Settings">
    <IsPackable>true</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <RootNamespace>RouteCheck</RootNamespace>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ToolCommandName>routecheck</ToolCommandName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package Information">
    <Authors>Daniel Höflehner</Authors>
    <Copyright>Copyright © Daniel Höflehner</Copyright>
    <Title>RouteCheck</Title>
    <Description>Check and view routes in your Terminal.</Description>
    <PackageIcon>icon.png</PackageIcon>
    <PackageId>RouteCheck</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/eisnstein/RouteCheck</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/eisnstein/RouteCheck/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>tool api webapi routes openapi</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <!-- NuGet.Packaging references the vulnerable Pkcs 8.0.1 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7).
       Remove this pin once NuGet.Protocol depends on a patched version. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- The startup hook is loaded into the web app, not into RouteCheck: it is built first and
       shipped next to RouteCheck as hook/RouteCheck.StartupHook.dll, but not referenced. -->
  <ItemGroup>
    <ProjectReference Include="..\StartupHook\RouteCheck.StartupHook.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\StartupHook\EndpointsContract.cs" Link="StartupHook\EndpointsContract.cs" />
    <None Include="..\StartupHook\bin\$(Configuration)\net8.0\RouteCheck.StartupHook.dll"
          Link="hook\RouteCheck.StartupHook.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="nupkg" />
    <None Include="Assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>