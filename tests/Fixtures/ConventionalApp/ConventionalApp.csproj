<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Started by the end-to-end tests. Not part of the solution, RouteCheck builds it itself.
       Targets several frameworks on purpose, so the framework option is needed to run it. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
