<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loaded into the web app via DOTNET_STARTUP_HOOKS, so it targets the lowest supported framework -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RouteCheck.StartupHook</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
